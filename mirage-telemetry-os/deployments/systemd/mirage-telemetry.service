[Unit]
Description=Mirage Telemetry OS service
After=network.target
[Service]
WorkingDirectory=/opt/mirage-telemetry-os
Environment=VEHICLE_PROFILE=fk8
Environment=UI_THEME=mirage-retro
ExecStart=/opt/mirage-telemetry-os/bin/telemetry-service -listen 127.0.0.1:8080
Restart=always
RestartSec=2
[Install]
WantedBy=multi-user.target
